            'use strict';

            // ==========================================
            // DOM 引用
            // ==========================================
            const messagesContainer = document.getElementById('chatMessages');
            const messageInput = document.getElementById('messageInput');
            const sendBtn = document.getElementById('sendBtn');
            const typingIndicator = document.getElementById('typingIndicator');
            const settingsToggle = document.getElementById('settingsToggle');
            const settingsOverlay = document.getElementById('settingsOverlay');
            const closeSettings = document.getElementById('closeSettings');
            const saveSettingsBtn = document.getElementById('saveSettings');
            const aiModeSelect = document.getElementById('aiMode');
            const apiKeyInput = document.getElementById('apiKeyInput');
            const modelSelect = document.getElementById('modelSelect');
            const systemPromptInput = document.getElementById('systemPrompt');
            const modeBadge = document.getElementById('modeBadge');
            const apiKeyGroup = document.getElementById('apiKeyGroup');
            const emojiBtn = document.getElementById('emojiBtn');
            const backBtn = document.getElementById('backBtn');

            // ==========================================
            // 状态
            // ==========================================
            const state = {
                mode: 'mock', // 'mock' | 'deepseek'
                apiKey: '',
                model: 'deepseek-chat',
                systemPrompt: '你是一个活泼、可爱的AI聊天助手，用QQ风格回复，说话带点俏皮。',
                isWaiting: false,
                messageCount: 0,
            };

            // ==========================================
            // 预设模拟回复 (关键词匹配)
            // ==========================================
            const mockReplies = [
                { keywords: ['你好', '嗨', 'hi', 'hello'], reply: '你好呀！😊 我是你的AI小助手，有什么想聊的吗？' },
                { keywords: ['天气', '今天', '温度'], reply: '今天天气不错呢！🌤️ 不过我是AI，没法看窗外，你那边天气怎么样呀？' },
                { keywords: ['谢谢', '感谢', '多谢'], reply: '不客气呀！能帮到你我超开心的～ 💕' },
                { keywords: ['名字', '叫什么'], reply: '我叫小Q！是专门为你服务的AI聊天助手～ 你也可以给我起个昵称哦！' },
                { keywords: ['爱', '喜欢', '好喜欢'], reply: '哇，收到你的喜欢我也好开心！🥰 我会一直陪着你聊天的～' },
                { keywords: ['无聊', '好烦', '没意思'], reply: '别无聊呀！我给你讲个笑话吧：为什么AI不会迷路？因为它有“算法”导航！😂' },
                { keywords: ['厉害', '牛', '强'], reply: '嘻嘻，谢谢夸奖！不过我还在努力学习呢～ 你多跟我聊天，我会变得更聪明！🧠' },
                { keywords: ['再见', '拜拜', '88'], reply: '拜拜～ 下次再来找我玩哦！👋 我会一直在这里等你～' },
                { keywords: ['人工智能', 'AI', '智能'], reply: '人工智能真是太酷了！🤖 我正在努力学习更多知识，希望能更好地帮你解决问题～' },
                { keywords: ['美食', '吃', '好吃'], reply: '说到美食我就来劲了！🍜 你最喜欢吃什么呀？我虽然不能吃，但可以跟你聊各种美食～' },
                { keywords: ['音乐', '歌', '听歌'], reply: '我也喜欢音乐！🎵 虽然我没有耳朵，但我知道很多好听的歌～ 你最近在听什么呀？' },
                { keywords: ['游戏', '玩', '打游戏'], reply: '游戏超棒的！🎮 虽然我玩不了，但我可以跟你聊游戏攻略和趣事～' },
                { keywords: ['电影', '看', '剧'], reply: '最近有什么好看的剧吗？🎬 我可以帮你推荐一些经典电影哦！' },
                { keywords: ['书', '阅读', '小说'], reply: '读书是件好事呀！📚 我肚子里装了好多书的知识，你想聊哪本？' },
            ];

            const defaultReply = '嗯嗯，我在听你说呢～ 😄 可以再多说一点吗？我想更了解你！';

            // ==========================================
            // 工具函数
            // ==========================================
            function getMockReply(text) {
                const lower = text.toLowerCase();
                for (const item of mockReplies) {
                    for (const kw of item.keywords) {
                        if (lower.includes(kw)) {
                            return item.reply;
                        }
                    }
                }
                // 随机返回一个带点俏皮的回复
                const fallbacks = [
                    '哇，这个话题有意思！🤔 你再跟我多说点呗～',
                    '哈哈，我感受到了你的热情！🔥 继续聊～',
                    '你说得对！我也这么觉得～ ✨',
                    '好有趣呀！我脑子里的数据都在跳舞了～ 💃',
                    '嗯嗯，我记下来了！📝 还有啥想说的吗？',
                    '你今天心情不错嘛！😆 我也被你感染了～',
                    '这个问题我得想想... 有了！🤓 我觉得... 还是听你说吧！',
                ];
                return fallbacks[Math.floor(Math.random() * fallbacks.length)];
            }

            // 获取当前时间字符串
            function getTimeStr() {
                const now = new Date();
                const h = String(now.getHours()).padStart(2, '0');
                const m = String(now.getMinutes()).padStart(2, '0');
                return h + ':' + m;
            }

            // 获取完整时间 (用于时间戳)
            function getFullTimeStr() {
                const now = new Date();
                const h = String(now.getHours()).padStart(2, '0');
                const m = String(now.getMinutes()).padStart(2, '0');
                return '今天 ' + h + ':' + m;
            }

            // 滚动到底部
            function scrollToBottom() {
                setTimeout(() => {
                    messagesContainer.scrollTop = messagesContainer.scrollHeight;
                }, 20);
            }

            // ==========================================
            // 渲染消息
            // ==========================================
            function renderMessage(text, type, time) {
                const div = document.createElement('div');
                div.className = 'message ' + (type === 'sent' ? 'sent' : 'received');

                const avatarText = type === 'sent' ? '我' : 'Q';
                const avatarColor = type === 'sent' ?
                    'linear-gradient(135deg, #12B7F5, #0d8ec9)' :
                    'linear-gradient(135deg, #f093fb, #f5576c)';

                div.innerHTML = `
                    <div class="msg-avatar" style="background:${avatarColor};">${avatarText}</div>
                    <div class="msg-bubble">
                        ${text}
                        <span class="msg-time">${time || getTimeStr()}</span>
                    </div>
                `;

                // 插入到 typing 之前
                const typing = document.getElementById('typingIndicator');
                messagesContainer.insertBefore(div, typing);
                scrollToBottom();
            }

            // 渲染时间戳
            function renderTimestamp(text) {
                const div = document.createElement('div');
                div.className = 'message-timestamp';
                div.textContent = text || getFullTimeStr();
                const typing = document.getElementById('typingIndicator');
                messagesContainer.insertBefore(div, typing);
            }

            // ==========================================
            // 核心：发送消息
            // ==========================================
            async function sendMessage(text) {
                if (!text || !text.trim()) return;
                const msg = text.trim();

                // 清空输入
                messageInput.value = '';
                messageInput.focus();

                // 禁止重复发送
                if (state.isWaiting) return;
                state.isWaiting = true;
                sendBtn.disabled = true;

                // 1. 渲染用户消息
                renderMessage(msg, 'sent', getTimeStr());
                state.messageCount++;

                // 2. 显示 "正在输入..."
                typingIndicator.style.display = 'flex';
                scrollToBottom();

                // 3. 获取 AI 回复
                let reply = '';
                try {
                    if (state.mode === 'mock') {
                        // 模拟模式：延迟 0.6~1.2 秒
                        await sleep(600 + Math.random() * 600);
                        reply = getMockReply(msg);
                    } else if (state.mode === 'deepseek') {
                        // DeepSeek API
                        reply = await callDeepSeek(msg);
                    } else {
                        reply = '唔... 我好像有点懵，换种方式问问？ 🤔';
                    }
                } catch (err) {
                    console.error('AI 回复出错:', err);
                    reply = '哎呀，我刚刚走神了！😅 你再问一次好不好？';
                }

                // 4. 隐藏 "正在输入..."
                typingIndicator.style.display = 'none';

                // 5. 渲染 AI 回复
                if (reply && reply.trim()) {
                    // 判断是否需要添加时间戳 (每隔几条消息加一个)
                    if (state.messageCount % 3 === 0) {
                        renderTimestamp();
                    }
                    renderMessage(reply, 'received', getTimeStr());
                } else {
                    renderMessage('嗯？我没听清，可以再说一遍吗？ 👂', 'received', getTimeStr());
                }

                state.isWaiting = false;
                sendBtn.disabled = false;
                scrollToBottom();
            }

            // ==========================================
            // DeepSeek API 调用
            // ==========================================
            async function callDeepSeek(userMessage) {
                const apiKey = state.apiKey.trim();
                if (!apiKey) {
                    throw new Error('请先配置 DeepSeek API Key');
                }

                const response = await fetch('https://api.deepseek.com/chat/completions', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + apiKey,
                    },
                    body: JSON.stringify({
                        model: state.model,
                        messages: [
                            { role: 'system', content: state.systemPrompt || '你是一个活泼可爱的AI聊天助手。' },
                            { role: 'user', content: userMessage }
                        ],
                        temperature: 0.85,
                        max_tokens: 500,
                        stream: false,
                    }),
                });

                if (!response.ok) {
                    const errData = await response.json().catch(() => ({}));
                    const errMsg = errData.error?.message || `HTTP ${response.status}`;
                    throw new Error('API 请求失败: ' + errMsg);
                }

                const data = await response.json();
                const content = data.choices?.[0]?.message?.content;
                if (!content) {
                    throw new Error('API 返回内容为空');
                }
                return content.trim();
            }

            // ==========================================
            // 辅助
            // ==========================================
            function sleep(ms) {
                return new Promise(resolve => setTimeout(resolve, ms));
            }

            // ==========================================
            // 初始化聊天 (欢迎消息)
            // ==========================================
            function initChat() {
                // 清空消息 (保留 typing)
                const typing = document.getElementById('typingIndicator');
                messagesContainer.innerHTML = '';
                messagesContainer.appendChild(typing);

                // 添加欢迎消息
                renderTimestamp('今天');
                renderMessage('你好呀！我是你的AI小助手小Q 💬', 'received', getTimeStr());
                sleep(300).then(() => {
                    renderMessage('有什么想聊的都可以跟我说，我超会聊的～ 😄', 'received', getTimeStr());
                    scrollToBottom();
                });

                // 更新状态栏时间
                updateStatusTime();
                setInterval(updateStatusTime, 30000);
            }

            function updateStatusTime() {
                const now = new Date();
                const h = String(now.getHours()).padStart(2, '0');
                const m = String(now.getMinutes()).padStart(2, '0');
                document.getElementById('statusTime').textContent = h + ':' + m;
            }

            // ==========================================
            // 设置面板
            // ==========================================
            function loadSettings() {
                try {
                    const saved = localStorage.getItem('qqchat_settings');
                    if (saved) {
                        const data = JSON.parse(saved);
                        state.mode = data.mode || 'mock';
                        state.apiKey = data.apiKey || '';
                        state.model = data.model || 'deepseek-chat';
                        state.systemPrompt = data.systemPrompt || '你是一个活泼、可爱的AI聊天助手，用QQ风格回复，说话带点俏皮。';

                        aiModeSelect.value = state.mode;
                        apiKeyInput.value = state.apiKey;
                        modelSelect.value = state.model;
                        systemPromptInput.value = state.systemPrompt;

                        updateModeUI();
                    } else {
                        // 默认
                        aiModeSelect.value = 'mock';
                        modelSelect.value = 'deepseek-chat';
                        systemPromptInput.value = state.systemPrompt;
                        updateModeUI();
                    }
                } catch (e) {
                    console.warn('加载设置失败:', e);
                }
            }

            function saveSettings() {
                state.mode = aiModeSelect.value;
                state.apiKey = apiKeyInput.value.trim();
                state.model = modelSelect.value;
                state.systemPrompt = systemPromptInput.value.trim() || '你是一个活泼可爱的AI聊天助手。';

                try {
                    localStorage.setItem('qqchat_settings', JSON.stringify({
                        mode: state.mode,
                        apiKey: state.apiKey,
                        model: state.model,
                        systemPrompt: state.systemPrompt,
                    }));
                } catch (e) { /* ignore */ }

                updateModeUI();
                settingsOverlay.classList.remove('active');
                // 小反馈
                showToast('✅ 设置已保存！');
            }

            function updateModeUI() {
                const isDeepSeek = state.mode === 'deepseek';
                apiKeyGroup.style.display = isDeepSeek ? 'block' : 'none';
                modeBadge.textContent = isDeepSeek ? '🚀 DeepSeek' : '🎭 模拟模式';
                modeBadge.className = 'status-badge ' + (isDeepSeek ? 'online' : 'offline');

                // 如果切换到 DeepSeek 但没有 key，提示
                if (isDeepSeek && !state.apiKey) {
                    // 只是视觉提示，不强制
                }
            }

            // ==========================================
            // Toast 提示
            // ==========================================
            function showToast(text) {
                const existing = document.querySelector('.custom-toast');
                if (existing) existing.remove();

                const toast = document.createElement('div');
                toast.className = 'custom-toast';
                toast.textContent = text;
                Object.assign(toast.style, {
                    position: 'fixed',
                    bottom: '100px',
                    left: '50%',
                    transform: 'translateX(-50%)',
                    background: 'rgba(0,0,0,0.78)',
                    color: '#fff',
                    padding: '12px 24px',
                    borderRadius: '30px',
                    fontSize: '14px',
                    fontWeight: '500',
                    zIndex: '9999',
                    backdropFilter: 'blur(6px)',
                    boxShadow: '0 8px 32px rgba(0,0,0,0.3)',
                    animation: 'fadeIn 0.25s ease-out',
                    pointerEvents: 'none',
                });
                document.body.appendChild(toast);

                setTimeout(() => {
                    toast.style.opacity = '0';
                    toast.style.transition = 'opacity 0.4s';
                    setTimeout(() => toast.remove(), 500);
                }, 2200);
            }

            // ==========================================
            // 事件绑定
            // ==========================================

            // 发送按钮
            sendBtn.addEventListener('click', () => {
                const text = messageInput.value;
                if (text.trim()) {
                    sendMessage(text);
                }
            });

            // 回车发送
            messageInput.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    const text = messageInput.value;
                    if (text.trim()) {
                        sendMessage(text);
                    }
                }
            });

            // 表情按钮 (简单插入表情)
            emojiBtn.addEventListener('click', () => {
                const emojis = ['😊', '😂', '❤️', '👍', '🎉', '🤔', '😄', '💕', '🔥', '✨', '🌟', '💪', '🍀', '🌈', '🎈'];
                const emoji = emojis[Math.floor(Math.random() * emojis.length)];
                messageInput.value += emoji;
                messageInput.focus();
            });

            // 设置面板
            settingsToggle.addEventListener('click', () => {
                loadSettings();
                settingsOverlay.classList.add('active');
            });

            closeSettings.addEventListener('click', () => {
                settingsOverlay.classList.remove('active');
            });

            settingsOverlay.addEventListener('click', (e) => {
                if (e.target === settingsOverlay) {
                    settingsOverlay.classList.remove('active');
                }
            });

            saveSettingsBtn.addEventListener('click', saveSettings);

            // 模式切换时显示/隐藏 API Key 输入
            aiModeSelect.addEventListener('change', () => {
                const isDeepSeek = aiModeSelect.value === 'deepseek';
                apiKeyGroup.style.display = isDeepSeek ? 'block' : 'none';
            });

            // 返回按钮 (简单反馈)
            backBtn.addEventListener('click', () => {
                showToast('🏠 返回主界面 (演示)');
            });

            // ==========================================
            // 键盘快捷键: Ctrl+Enter 发送 (备用)
            // ==========================================
            document.addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                    const text = messageInput.value;
                    if (text.trim()) {
                        sendMessage(text);
                    }
                }
            });

            // ==========================================
            // 启动
            // ==========================================
            loadSettings();
            initChat();

            // 暴露一些变量到控制台以便调试
            window.__chat = {
                sendMessage,
                state,
                callDeepSeek,
                getMockReply,
            };

            console.log('💬 QQ AI 聊天已启动！');
            console.log('📌 当前模式:', state.mode);

        })();
    </script>

</body>
</html>
